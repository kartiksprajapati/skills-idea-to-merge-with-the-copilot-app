---
---

<section class="bookmarks-card" aria-labelledby="bookmark-heading">
  <div class="intro">
    <p class="eyebrow">PERSONAL LINK LIBRARY</p>
    <h2 id="bookmark-heading">Save a link. Give it a little Mona magic.</h2>
    <p class="description">
      Turn any website into a memorable <code>mona-</code> shortcut that stays
      safely on this device.
    </p>
  </div>

  <form id="add-bookmark">
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="off"
        spellcheck="false"
        placeholder="example.com"
        required
      />
    </div>
    <button type="submit">Add bookmark <span aria-hidden="true">→</span></button>
  </form>

  <p id="form-message" class="form-message" role="status" aria-live="polite"></p>
  <p class="hint">Try <code>github.com</code> or paste a full <code>https://</code> link.</p>

  <div id="list-header" class="list-header" hidden>
    <div>
      <p class="eyebrow">YOUR COLLECTION</p>
      <h3 class="list-title">Saved bookmarks</h3>
    </div>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>
  <ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>
</section>

<style>
  .bookmarks-card {
    position: relative;
    overflow: hidden;
    padding: clamp(1.25rem, 4vw, 2rem);
    border: 1px solid color-mix(in srgb, var(--accent) 24%, var(--border));
    border-radius: 1.25rem;
    background:
      radial-gradient(circle at 100% 0%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 38%),
      color-mix(in srgb, currentColor 4%, transparent);
    box-shadow: 0 1.5rem 4rem color-mix(in srgb, #000 12%, transparent);
  }
  .intro { max-width: 34rem; }
  .eyebrow {
    margin: 0 0 0.4rem;
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  h2 {
    margin: 0;
    font-family: var(--font-head);
    font-size: clamp(1.35rem, 4vw, 2rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
  }
  .description { margin: 0.7rem 0 0; color: var(--muted); }
  code { font-size: 0.9em; }
  form { margin-top: 1.5rem; }
  form button { white-space: nowrap; }
  form button span { margin-left: 0.35rem; font-size: 1.1em; }
  input { background: color-mix(in srgb, currentColor 5%, transparent); }
  .form-message {
    min-height: 1.35rem;
    margin: 0.65rem 0 0;
    color: #ef6a6a;
    font-size: 0.8rem;
  }
  .form-message.success { color: #39b982; }
  .hint { margin-bottom: 1.75rem; }
  .list-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin: 1.5rem 0 0.75rem;
  }
  .list-header .eyebrow { margin-bottom: 0.15rem; }
  .list-title { margin: 0; font-family: var(--font-head); font-size: 1.1rem; }
  .clear { padding: 0.4rem 0.7rem; font-size: 0.75rem; }
  .empty { margin: 0; background: color-mix(in srgb, currentColor 3%, transparent); }
  ul { margin: 0; }
  li.bookmark {
    align-items: center;
    padding: 0.75rem;
    border-color: color-mix(in srgb, var(--accent) 16%, var(--border));
    background: color-mix(in srgb, currentColor 3%, transparent);
  }
  .bookmark .url { color: inherit; text-decoration-color: color-mix(in srgb, var(--accent) 60%, transparent); text-underline-offset: 0.2em; }
  .bookmark .slug { color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .bookmark .copy { padding: 0.3rem 0.55rem; }
</style>

<script>
  import { createSlug, formatBookmark, loadBookmarks, normalizeUrl, saveBookmarks } from '../lib/bookmarks.mjs';

  const STORAGE_KEY = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const message = document.getElementById('form-message');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearButton = document.getElementById('clear-all');
  let bookmarks = [];

  function readBookmarks() {
    try {
      return loadBookmarks(window.localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  function writeBookmarks() {
    try {
      window.localStorage.setItem(STORAGE_KEY, saveBookmarks(bookmarks));
    } catch {
      showMessage('This browser could not save the bookmark.', false);
    }
  }

  function showMessage(text, success) {
    if (!message) return;
    message.textContent = text;
    message.classList.toggle('success', success);
  }

  function renderBookmarks() {
    if (!list || !emptyState || !listHeader) return;
    list.replaceChildren();
    emptyState.hidden = bookmarks.length > 0;
    listHeader.hidden = bookmarks.length === 0;

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.textContent = ' :: ';

      const slug = document.createElement('code');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copy = document.createElement('button');
      copy.className = 'copy';
      copy.type = 'button';
      copy.textContent = 'Copy';
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          copy.textContent = 'Copied';
          window.setTimeout(() => { copy.textContent = 'Copy'; }, 1200);
        } catch {
          showMessage(`Copy this slug: ${formatBookmark(bookmark)}`, false);
        }
      });

      item.append(link, separator, slug, copy);
      list.append(item);
    }
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!(input instanceof HTMLInputElement)) return;

    try {
      const url = normalizeUrl(input.value);
      const bookmark = { url, slug: createSlug(bookmarks.map(({ slug }) => slug)) };
      bookmarks = [bookmark, ...bookmarks];
      writeBookmarks();
      renderBookmarks();
      input.value = '';
      showMessage('Bookmark saved.', true);
    } catch (error) {
      showMessage(error instanceof Error ? error.message : 'Enter a valid URL.', false);
    }
  });

  clearButton?.addEventListener('click', () => {
    if (bookmarks.length === 0 || !window.confirm('Clear all saved bookmarks?')) return;
    bookmarks = [];
    try {
      window.localStorage.removeItem(STORAGE_KEY);
    } catch {
      showMessage('This browser could not clear saved bookmarks.', false);
    }
    renderBookmarks();
    showMessage('Bookmarks cleared.', true);
  });

  bookmarks = readBookmarks();
  renderBookmarks();
</script>
